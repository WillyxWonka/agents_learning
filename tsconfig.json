{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src", //source TypeScript files go under `src`
    "outDir": "./dist", //compiled JavaScript and related outputs go under `dist`

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true, //assumes that accessing an array or object by index may return undefined
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true, //disallow property access via an index signature
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,

    // "erasableSyntaxOnly": true, //makes certain syntax erasable, like type assertions, but not type annotations. This is useful for code that will be erased by a transformer, like Babel or SWC.
    "noErrorTruncation": true, //prevents TypeScript from truncating error messages, which can be useful for debugging

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
